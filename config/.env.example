# Template only. Copy to config/.env.qa (ENV=qa is the default) and fill in.
# config/.env.* is gitignored, but THIS file is committed: never put real values here.
# In CI, these come from the repo's GitHub Actions secrets.
BASE_URL=https://provider-qa.xspan.ai/
SUPER_ADMIN=
SUPER_ADMIN_PASSWORD=
ORG_ADMIN=
PASSWORD=
PHYSICIAN_ROLE=
CUSTOM_ROLE=
TECHADMIN_ROLE=
MARKETING_ROLE=
CLINICAL_ROLE=
DIETICIAN_ROLE=
CARECOORDINATOR_ROLE=
NURSE_ROLE=

# CareHub 2FA: each account's authenticator key (<ROLE>_TOTP_SECRET next to the
# var holding its email). Fill them with the set-up script, one or more roles:
#   ROLE=ORG_ADMIN npm run setup:2fa
#   ROLE=PHYSICIAN_ROLE,NURSE_ROLE npm run setup:2fa
# If the account already has an authenticator app, an org admin must first reset
# its two-step verification in CareHub (Staff list → Reset two-step verification).
SUPER_ADMIN_TOTP_SECRET=
ORG_ADMIN_TOTP_SECRET=
PHYSICIAN_ROLE_TOTP_SECRET=
NURSE_ROLE_TOTP_SECRET=
CARECOORDINATOR_ROLE_TOTP_SECRET=
DIETICIAN_ROLE_TOTP_SECRET=
CLINICAL_ROLE_TOTP_SECRET=
MARKETING_ROLE_TOTP_SECRET=
TECHADMIN_ROLE_TOTP_SECRET=
CUSTOM_ROLE_TOTP_SECRET=
